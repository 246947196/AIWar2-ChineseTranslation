# Compiled DLLs
DLLBin/*.dll

# Build artifacts
DLLSource/**/obj/
DLLSource/**/bin/

# BepInEx framework files (not source)
BepInEx/core/*.xml

# Python cache
__pycache__/
*.pyc

translation_update_report_*.txt

# PatchedAssemblies: 汉化后的核心 DLL（IL 汉化产物，见规范 8.15）。备份不入库
PatchedAssemblies/*.bak

# ilpatch build artifacts
tools/ilpatch/bin/
tools/ilpatch/obj/
tools/ilpatch/*.extract.json

# WorkBuddy session data
.workbuddy/

# AI War 1 对照表（非本项目文件）
1代中英对照表.csv

# 过期扩展备份
Expansions_BACKUP_corrupted/

# 生成物：python tools/localize_xml.py build 的产出（每次按当前游戏版本现生成）
build_output/
translation_gaps.tsv

# 构建符号
*.pdb

# 游戏自动生成的快速开局存档副本（与游戏目录内同名文件逐字节相同）
*.save
*.savemet

# 旧版补丁 DLL 归档（可从 git 历史恢复）
PatchedAssemblies/old_*/

# DLL 待译清单（由 ilpatch extract + merged.json 差集生成）
translation_gaps_dll.tsv

# 游戏原文件备份（体积大，按需生成）
_backup/

# 发布包（体积大，按需生成）
dist/

# 外部代码 DLL 的未打补丁基线（由游戏目录取得，可重新生成）
DLLBin/_base/
