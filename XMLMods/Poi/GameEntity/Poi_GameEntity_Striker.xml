	<!-- StrikerDireGuardiansGroup -->

	<!-- 
		lets make them worth 3x normal dire guardians
		1x value of a guardian, in their own stats
		2x value of a guardian, in drones

		dire pike guardian is 8000 cost
		so this one is 24000

		lets pick 2 drone types for each guardian
		8000 ai purchase cost worth of each

    	human_squad_cap_multiplier_list_cumulative="1.4,1.6,1.5,1.3,1,1,1"
		in sum that means a mark 7 strikecraft line is boosted in cap by... x4.368
		...
		probably this means that pre-multiplying the drone count to be '8000' ai purchase cost worth
		is going to end up being 4x as much as expected...

	-->
	<entity
			name="StrikerDireGuardian"
			copy_from="StrikerGuardian_Base"

			thematic_groups="AI,DireGuardian"
			tags="AIDireGuardian"
			special_entity_type="AIDireGuardian"
			category="Ship"
			priority_as_ai_target="BigThreateningWeapon"
			priority_as_frd_target="BigThreateningWeapon"
			priority_to_protect="BigFavoriteToy"
			
			visuals="assets/_finalgamemeshes/humanoddities/colonyship/colonyship.prefab"
			material_override_path="Assets/_FinalGameMeshes/Resources/MatterConverter/MatterConverter.prefab"
			icon_name="Ships1/ColonyShip"
			icon_overlay="Overlays2/Guardian_Carrier"
			gimbal_icon_size_multiplier="1.75"
			size_scale="10"
			visuals_scale_multiplier="15"
			y_offset_of_icon="16"
			collision_priority="400"
			uses_large_health_bar="true"

			display_name="打击者可怕守卫"
			display_name_for_sidebar="打击者DGU"
			description="快速运输大量AI打击机投入战斗。"

			starting_mark_level="Mark7"
			tech_upgrades_that_benefit_me="Unused"
			does_not_use_multipliers_from_mark_level="true"

			hull_points="1400000"
			shield_points="700000"
			metal_cost="800000"
			energy_consumption="25000"
			cost_for_ai_to_purchase="24000"
			>

		<system
				name="V1"
				display_name="可怕爆破弹"
				category="Weapon"
				firing_timing="OnlyInRange"
				damage_per_shot="4000"
				range="AboveAverage1"
				shot_speed="Normal"
				rate_of_fire="Misery"
				shots_per_salvo="30"
				fires_salvos_sequentially="false"
				shot_type_data="PikeShot_Gold"
				>
			<outgoing_damage_modifier
					based_on="Armor_mm"
					comparison_type="AtLeast"
					compared_to="90"
					multiplier="6"
					/>
			<outgoing_damage_modifier
					based_on="CurrentHullPercentage"
					applies_to="HullOnly"
					comparison_type="AtLeast"
					compared_to="75"
					multiplier="2"
					/>
		</system>

		<ai_ship_group_membership
				name="StrikerDireGuardiansGroup"
				weight="100"
				/>
	</entity>


