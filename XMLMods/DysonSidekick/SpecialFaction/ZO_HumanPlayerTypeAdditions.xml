<?xml version="1.0" encoding="utf-8"?>
<root>

  <faction name="Human" is_partial_record="true">
    <!-- custom fields. -->

    <custom_field requires_player_types="DarkZenithSidekick,DarkZenithEmpire"
                  name="Intensity" display_name="强度" description="决定暗天顶的总战力预算"
                  sort_group="200" setting_type="IntSlider" default="5" min="1" max="10"/>
    
     <custom_field  requires_player_types="DarkZenithSidekick,DarkZenithEmpire" name="InvasionTime" display_name="入侵时间" description="默认情况下你的部队是一支完整的暗天顶入侵部队。选择斯维卡里的话，你将以一支小型部队与你的帝国盟友一同出生。如果你选择DZ帝国，必须选择全面入侵。"
                   sort_group="210" setting_type="CustomDropdownArbitraryOptions" arbitrary_options="Svikari,全面入侵" default_option="全面入侵" />

        <custom_field requires_player_types="DarkZenithSidekick,DarkZenithEmpire"
                  name="NadirStrength" display_name="纳迪尔力量" description="纳迪尔由AI生成以对抗暗天顶；与他们作战是暗天顶获取资源的重要来源。"
                  sort_group="250" setting_type="IntSlider" default="5" min="1" max="10"/>
    <custom_field requires_player_types="DarkZenithSidekick,DarkZenithEmpire"
                  name="DZSidekickStartingFlagship" display_name="起始旗舰" description="你想从哪艘旗舰开始？"
                  sort_group="100" setting_type="CustomDropdownArbitraryOptions" arbitrary_options="Medusa,Asclepius,Chameleon,随机" default_option="随机"/>
    
    <custom_field requires_player_types="ScourgeInfusedHumanEmpire"
                                     name="ScourgeVassalIntensity" display_name="天灾强度" description="你的天灾盟友的强度。" setting_type="IntSlider" default="5" min="1" max="10"/>
    <custom_field requires_player_types="ScourgeInfusedHumanEmpire"
                   name="FirstArmory" display_name="首个军械库" description="天灾将建造的首个军械库。"
                  sort_group="260" setting_type="CustomDropdownArbitraryOptions" arbitrary_options="随机,Burlust,Evuck,Neinzul,Peltian,Thoraxian" default_option="随机" />
    <custom_field requires_player_types="ScourgeInfusedHumanEmpire"
                   name="StartsWithBane" is_advanced_setting="true" display_name="起始拥有旗舰" description="天灾注入帝国在游戏开始时获得一艘强大的天灾主题旗舰。"
                  sort_group="300"  setting_type="BoolToggle" default="false"  />


    <custom_field  requires_player_types="DarkZenithSidekick,DarkZenithEmpire"
                    name="EnableFimbulwinter" is_advanced_setting="true" display_name="启用芬布尔之冬" description="启用后，暗天顶将尝试带来芬布尔之冬，改造银河中的所有行星以适应其需求。暗天顶将开始改造其占领的行星；一旦改造完成，DZ及其盟友在那里会更强大，而其敌人会更弱。

切勿禁用。"
                  sort_group="800" setting_type="BoolToggle" default="true"  />

    <custom_field   requires_player_types="DarkZenithSidekick,DarkZenithEmpire" is_advanced_setting="true"
        name="Allegiance" display_name="归属" description="这些天顶忠于玩家。"
                  sort_group="900" setting_type="CustomDropdownArbitraryOptions" arbitrary_options="对玩家友好" default_option="对玩家友好" />
  </faction>
</root>
