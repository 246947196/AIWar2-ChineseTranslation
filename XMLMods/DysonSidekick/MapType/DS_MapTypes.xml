              type_name="Arcen.AIW2.External.Mapgen_Circles"
              min_planets="40"
              max_planets="300"

              >
    <map_option name="SolarSystemsLinkMethod" display_name="Map Linking Algorithm" description="Linking Mechanism for Map; controls map connectivity.">
      <choice_value id="0" display_name="Solar System" description="Connect planets via Solar Systems method." related_int_value="0" />
      <choice_value id="1" display_name="Broken" description="Connect planets via spanning tree only." related_int_value="1" />
      <choice_value id="3" display_name="Spiderweb" description="Connect planets via Gabriel Graph." related_int_value="2" />
      <choice_value id="4" display_name="Haystack" description="Connect planets via Spanning Graph." related_int_value="3" />
    </map_option>
  </map_type>

