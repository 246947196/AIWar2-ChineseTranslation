<?xml version="1.0" encoding="utf-8"?>
<root>

    <galaxy_setting category="Outguard" is_partial_record="true"
                    name="OutguardToSeed"
                    default="6"
                    description="How many Outguard Beacons will be seeded throughout the galaxy? By default (with Outguard Party) this is 6. Standard is 5."
                    >
        <harshness_override min_campaign_harshness_to_apply="0"
                            disable_override="true"
                            />
    </galaxy_setting>

    <galaxy_setting name="OutguardPerBeacon" is_partial_record="true"
                    category="Outguard"
                    default="1"
                    description="How many Outguard are at each Beacon? By default (with Outguard Party) this is 1. Standard is 2."
                    >
        <harshness_override min_campaign_harshness_to_apply="0"
                            disable_override="true"
                            />
    </galaxy_setting>

    <galaxy_setting name="StartingOutguard"
                    category="Outguard"
                    display_name="起始外卫"
                    type="CustomDropdownCoreTable"
                    default_option="Random"
                    related_table="OutguardGroups"
                    description="选择是否在起始行星上放置外卫信标。"
                    >
    </galaxy_setting>

    <galaxy_setting name="FavorNewOutguard"
                    category="Outguard"
                    display_name="偏好新外卫"
                    type="CustomDropdownArbitraryOptions"
                    arbitrary_options="0x,1x,2x,3x"
                    default_option="1x"
                    description="来自此模组的新外卫可以有更高的生成几率。默认为1倍，0倍将禁用它们。"
                    >
    </galaxy_setting>

    <galaxy_setting name="OutguardCostScaling" is_partial_record="true"
                    category="Outguard"
                    display_name="外卫成本缩放"
                    type="CustomDropdownArbitraryOptions"
                    description="降低外卫入侵的AIP和HaP成本。默认（使用外卫派对时）为0.25倍。标准为1倍。"
                    arbitrary_options="0x,0.25x,0.5x,1x"
                    default_option="0.25x"
                    >
        <harshness_override min_campaign_harshness_to_apply="0"
                            disable_override="true"
                            />
    </galaxy_setting>

</root>