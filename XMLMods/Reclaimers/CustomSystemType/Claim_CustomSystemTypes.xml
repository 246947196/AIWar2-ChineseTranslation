            dll_name="AIWarExternalCode"
            type_name="Arcen.AIW2.External.System_Transformation"
            style="Activate"
            input_number="1"
            cooldown="300"
            duration="30"
            transform_into="RageGolem_Enraged"
            transform_back="RageGolem"
            description="暂时获得速度、伤害增强并减少受到的伤害。"

            text_line_1="$(Name): Transform into $(TransformInto) for $(Duration) once every $(Cooldown) ($(Status)) $(Activity)"
