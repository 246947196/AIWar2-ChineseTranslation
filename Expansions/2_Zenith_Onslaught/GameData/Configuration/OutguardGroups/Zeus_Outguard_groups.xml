<root>
	<item name="ShadesofHades" display_name="冥河魅影" on_spawn_behaviour="Attack" class="Offense" planetary_summoning_restriction="AIOnly" aip_cost_on_contact="10" seconds_allowed_to_exist="120" times_allowed_to_summon="2" aip_per_additional_summon="85" time_between_summons_in_seconds="360" repair_time_in_seconds="720" description="冥河魅影是一支精锐且神秘的突袭部队，由一群魅影战机、精英幻影护卫舰和一队强化型幻影战机组成。他们偏好打了就跑的战术，不会停留太久。" parsed_data_type="EntityName" data_list="Shade,HadesMirage" spawn_count_type="RawCount,Strength_BaseMark" min_spawn_value_list="6,2500" min_spawn_count_increase_per_aip_interval="0,5" spawn_count_increase_aip_threshold="1" multi_pick_list="1" />
	<item name="RagnarsBreachers" display_name="拉格纳的破阵者" on_spawn_behaviour="DefendLocalPlanet" class="Offense" planetary_summoning_restriction="AIOnly" aip_cost_on_contact="10" seconds_allowed_to_exist="180" times_allowed_to_summon="2" aip_per_additional_summon="100" time_between_summons_in_seconds="300" repair_time_in_seconds="1200" description="拉格纳原本是一位才华横溢的工程师，后来沦为海盗。他提出以提供独特服务来换取对其过往盗窃行为的赦免。拉格纳信守承诺，提供了可自行部署的闪电战炮塔和临时炮塔，这些炮塔能释放自主无人机，在AI世界建立滩头阵地非常有效。" parsed_data_type="EntityName" data_list="RagnarBlitzkriegTurret,RagnarMakeshiftTurret" spawn_count_type="RawCount,Strength_BaseMark" min_spawn_value_list="3,5000" min_spawn_count_increase_per_aip_interval="0,5" spawn_count_increase_aip_threshold="1" multi_pick_list="1" /> 	
	<item name="Hyperion" display_name="亥伯龙神" on_spawn_behaviour="PatrolAdjacentFriendlyAndNeutralPlanets" class="Defense" planetary_summoning_restriction="NotAI" aip_cost_on_contact="15" seconds_allowed_to_exist="600" times_allowed_to_summon="1" aip_per_additional_summon="100" time_between_summons_in_seconds="1200" repair_time_in_seconds="1500" spawn_delay="30" description="亥伯龙神要塞是维克斯安大屠杀最后幸存者的家园。他们发誓在AI被击败之前绝不定居新行星。亥伯龙神配备了一门强大的星爆光束炮，可同时向十个方向射击。" parsed_data_type="EntityName" data_list="Hyperion" spawn_count_type="RawCount" /> 			
	<item name="HephaestusRecyclingIndustries" display_name="赫菲斯托斯回收工业" on_spawn_behaviour="DefendLocalPlanet" class="Stationary" planetary_summoning_restriction="NotAI" aip_cost_on_contact="10" seconds_allowed_to_exist="300" times_allowed_to_summon="2" aip_per_additional_summon="100" time_between_summons_in_seconds="600" repair_time_in_seconds="900" description="赫菲斯托斯回收工业原本是一家利润丰厚的再加工工厂，现已转向战争用途。他们将借出一座堡垒大小的破碎机炮塔，以及一组经过改装的酸液炮塔和干扰炮塔，用于保卫我们的一颗行星。" parsed_data_type="EntityName" data_list="ShipCompactor,PacifiyingJammerTurret,PotentAcidTurret" spawn_count_type="RawCount,Strength_BaseMark" min_spawn_value_list="1,3000,3000" min_spawn_count_increase_per_aip_interval="0,80,80" spawn_count_increase_aip_threshold="1" multi_pick_list="1" /> 		
	<item name="TrojanHorse" display_name="特洛伊木马" donate_to_player="true" on_spawn_behaviour="DefendLocalPlanet" class="Stationary" planetary_summoning_restriction="AIOnly" aip_cost_on_contact="10" seconds_allowed_to_exist="900" times_allowed_to_summon="2" aip_per_additional_summon="100" time_between_summons_in_seconds="720" repair_time_in_seconds="1200" description="名副其实的特洛伊木马是一艘被俘获并改装过的星际列车，能够在AI领土上明目张胆地隐藏起来，同时收集邻近行星的侦察情报。五分钟后，特洛伊木马会吸引敌人的注意。在被摧毁时，它会释放出特殊的“重甲步兵无人机”，这些无人机拥有出色的伏击加成，能巧妙地抓住突袭时机。" parsed_data_type="EntityName" data_list="TrojanHorse,CargoContainer" spawn_count_type="RawCount,Strength_BaseMark" min_spawn_value_list="1,40" min_spawn_count_increase_per_aip_interval="0,20" spawn_count_increase_aip_threshold="1" multi_pick_list="1" /> 	
	<item name="DemetersCornucopia" display_name="德墨忒尔的丰饶角" donate_to_player="true" on_spawn_behaviour="DefendLocalPlanet" class="Stationary" planetary_summoning_restriction="NotAI" aip_cost_on_contact="5" seconds_allowed_to_exist="300" times_allowed_to_summon="1" aip_per_additional_summon="100" time_between_summons_in_seconds="1800" repair_time_in_seconds="1800" description="德墨忒尔矿业公司借出他们的“丰饶角”，这是一台最先进的金属采集器。只有在我们的金属经济需要提振时，才应该召唤这支外援，否则它在运作时会慢慢解体，造成资源浪费。" parsed_data_type="EntityName" data_list="DemetersCornucopia" spawn_count_type="RawCount" min_spawn_value_list="1" /> 	
	<item name="TheMonarch" display_name="君主" on_spawn_behaviour="Attack" class="Offense" planetary_summoning_restriction="Any" aip_cost_on_contact="50" seconds_allowed_to_exist="180" times_allowed_to_summon="1" aip_per_additional_summon="100" time_between_summons_in_seconds="900" repair_time_in_seconds="1200" description="只有在极度绝望的情况下，人类才会寻求邪恶的君主的帮助。这位君主是个无情的恶棍，痴迷于鳞翅目昆虫学。不过就盟友而言，我们可能找不到比他更好的了。君主将一艘废弃的蜂巢傀儡改造为他的巢穴，配备了一门强大的闪电炮。但他真正的力量来自于他狂热的追随者。他的“杀人蝇”会蜂拥攻击任何反对他的人，而他的副手总督也会时刻确保君主不会做出太鲁莽的举动。" parsed_data_type="EntityName" data_list="TheMonarch,TheViceroy" spawn_count_type="RawCount" min_spawn_value_list="1" /> 		
	<item name="ZenithTrader" display_name="天顶商人" on_spawn_behaviour="DefendLocalPlanet" class="Offense" planetary_summoning_restriction="NotAI" aip_cost_on_contact="5" seconds_allowed_to_exist="30" times_allowed_to_summon="1" aip_per_additional_summon="100" time_between_summons_in_seconds="600" repair_time_in_seconds="1200" description="我们发现了天顶商人响应的呼叫频率，可以短暂地将其召唤到我们的一颗行星上。它只会停留很短的时间，所以我们必须迅速与其进行交易。" parsed_data_type="EntityName" data_list="ZenithTrader" spawn_count_type="RawCount" min_spawn_value_list="1" /> 	
	<item name="Voidcallers" display_name="虚空召唤者" on_spawn_behaviour="DefendLocalPlanet" class="Stationary" planetary_summoning_restriction="Any" aip_cost_on_contact="10" seconds_allowed_to_exist="60" times_allowed_to_summon="2" aip_per_additional_summon="100" time_between_summons_in_seconds="300" repair_time_in_seconds="900" description="虚空召唤者是一群神秘主义者和科学家的奇特组合，他们发现了 warp 网格的深奥特性。他们可以利用这些知识，在我们选择的引力井处临时制造引力裂隙来帮助我们。这些裂隙只会持续一分钟，但会产生巨大的引力扭曲，除了引擎最强劲的飞船外，所有飞船都会被减速，并且无法通过虫洞离开。此外，裂隙的中心密度极高，陷入其事件视界的飞船会被拉向中心，被巨大的内爆力碾碎。" parsed_data_type="EntityName" data_list="GravitationalRift" spawn_count_type="RawCount" min_spawn_value_list="1" /> 	
	<item name="CyborgPacificists" display_name="赛博和平主义者" on_spawn_behaviour="DefendLocalPlanet" class="Offense" planetary_summoning_restriction="Any" aip_cost_on_contact="8" seconds_allowed_to_exist="90" times_allowed_to_summon="1" aip_per_additional_summon="100" time_between_summons_in_seconds="300" repair_time_in_seconds="900" description="赛博银河和平委员会是一个边缘组织，致力于实现生物智能与人工智能的终极融合。尽管他们的和平主义理念似乎使他们不太适合作为盟友，但他们有一种不可思议的能力，可以压制AI的攻击性，并能在引力井处维持短暂的停火。也许我们可以利用这段暂时的停火时间，获得一些通过常规手段无法得到的优势。" parsed_data_type="EntityName" data_list="CyborgAmbassador" spawn_count_type="RawCount" min_spawn_value_list="1" /> 	
	<item name="Spymaster" display_name="间谍大师" donate_to_player="true" on_spawn_behaviour="DefendLocalPlanet" class="Offense" planetary_summoning_restriction="Any" can_summon_on_unexplored="true" aip_cost_on_contact="8" seconds_allowed_to_exist="300" times_allowed_to_summon="1" aip_per_additional_summon="100" time_between_summons_in_seconds="600" repair_time_in_seconds="1200" description="间谍大师是一位间谍专家，能够提供距离其所在位置多达四个链路远的行星的侦察情报。它拥有一门强大的超光速粒子束，可在其被召唤的引力井处揭露敌方隐形单位。间谍大师每次只能停留几分钟，但会有一群间谍随行，这些间谍会持续存在，并可以接受直接命令进行转移。" parsed_data_type="EntityName" data_list="Spymaster,OutguardSpy" spawn_count_type="RawCount" min_spawn_value_list="1,8" />
