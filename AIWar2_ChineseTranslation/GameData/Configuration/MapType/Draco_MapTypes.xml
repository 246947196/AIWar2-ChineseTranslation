	<map_type name="D18Rings"
              display_name="链接环"
              description="生成的环嵌套在其他环上，以此类推。
              
在死亡愿望模式及以上不可用。"
              dll_name="AIWarExternalDeepProcessingCode"
              type_name="Arcen.AIW2.External.Mapgen_D18_LinkedRings"
              min_planets="40"
              max_planets="300"
              hidden_from_lists_above_harshness="2200"
	>
    <map_option name="ExtraSatellitesToHitTarget" display_name="是否添加额外行星以达到目标数量？"
      description="是否添加额外行星以达到目标行星数量？否则此地图类型可能生成的行星数量过少。" default_id="1">
      <choice_value id="0" display_name="否" description="这样看起来更整齐，但有时行星数量会较少。" related_int_value="0" />
      <choice_value id="1" display_name="是" description="这会更杂乱，但几乎肯定会有你请求的行星数量。" related_int_value="1" />
    </map_option>
	</map_type>
	<map_type name="D18Swirl"
              display_name="漩涡"
              description="行星排列在同心椭圆环中，根据邻近关系连接。类似于同心环。"
              dll_name="AIWarExternalDeepProcessingCode"
              type_name="Arcen.AIW2.External.Mapgen_D18_Ellipses"
              author_line="Credit to Draco18s"
              min_planets="40"
              max_planets="300"
	      >
          
	</map_type>
	<map_type name="D18Bubbles"
              display_name="气泡"
              description="有点像肥皂泡。环彼此靠近聚集，并与相邻的环相连。
              
在死亡愿望模式及以上不可用。"
              dll_name="AIWarExternalDeepProcessingCode"
              type_name="Arcen.AIW2.External.Mapgen_D18_Bubbles"
              min_planets="40"
              max_planets="300"
              hidden_from_lists_above_harshness="2200"
	>
    <map_option name="PlanetsPerBubble" display_name="每个气泡的行星数"
      description="每个气泡中有多少行星？这个数字也会决定有多少个气泡。" default_id="7">
      <choice_value id="0" display_name="三个" description="每个气泡三个行星。" related_int_value="3" />
      <choice_value id="1" display_name="四个" description="每个气泡四个行星。" related_int_value="4" />
      <choice_value id="2" display_name="五个" description="每个气泡五个行星。" related_int_value="5" />
      <choice_value id="3" display_name="六个" description="每个气泡六个行星。" related_int_value="6" />
      <choice_value id="4" display_name="七个" description="每个气泡七个行星。" related_int_value="7" />
      <choice_value id="5" display_name="八个" description="每个气泡八个行星。" related_int_value="8" />
      <choice_value id="6" display_name="九个" description="每个气泡九个行星。" related_int_value="9" />
      <choice_value id="7" display_name="十个" description="每个气泡十个行星。这是默认值。" related_int_value="10" />
      <choice_value id="8" display_name="十一个" description="每个气泡十一个行星。" related_int_value="11" />
      <choice_value id="9" display_name="十二个" description="每个气泡十二个行星。" related_int_value="12" />
      <choice_value id="10" display_name="十三个" description="每个气泡十三个行星。" related_int_value="13" />
      <choice_value id="11" display_name="十四个" description="每个气泡十四个行星。" related_int_value="14" />
    </map_option>
    <map_option name="RandomExtraConnections" display_name="随机额外环数"
      description="气泡内或气泡间应有多少额外环？" default_id="0">
      <choice_value id="0" display_name="无" description="除默认连接外无额外连接。" related_int_value="0" />
      <choice_value id="1" display_name="五个" description="随机添加五个额外连接，但不与其他线路或行星重叠。" related_int_value="5" />
      <choice_value id="2" display_name="十个" description="随机添加十个额外连接，但不与其他线路或行星重叠。" related_int_value="10" />
      <choice_value id="3" display_name="十五个" description="随机添加十五个额外连接，但不与其他线路或行星重叠。" related_int_value="15" />
      <choice_value id="4" display_name="二十个" description="随机添加二十个额外连接，但不与其他线路或行星重叠。" related_int_value="20" />
      <choice_value id="5" display_name="二十五个" description="随机添加二十五个额外连接，但不与其他线路或行星重叠。" related_int_value="25" />
      <choice_value id="6" display_name="三十个" description="随机添加三十个额外连接，但不与其他线路或行星重叠。" related_int_value="30" />
    </map_option>
	</map_type>
