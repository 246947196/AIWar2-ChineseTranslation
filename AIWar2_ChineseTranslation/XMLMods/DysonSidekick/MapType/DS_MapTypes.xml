       </map_option>
       <map_option name="NebulaeConnectivity" display_name="连接类型" description="整体连通性水平">
         <choice_value id="0" display_name="低" description="" related_int_value="0" />
         <choice_value id="1" display_name="中" description="" related_int_value="1" />
         <choice_value id="2" display_name="高" description="" related_int_value="2" />
       </map_option>
  </map_type>

