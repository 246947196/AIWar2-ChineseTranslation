  <map_type name="Solar_Systems_Lite"
              display_name="简化太阳系"
              description="该地图类型是由围绕中心环的一系列小环组成的。"
              dll_name="AIWarExternalDeepProcessingCode"
              type_name="Arcen.AIW2.External.Mapgen_Circles"
              min_planets="40"
              max_planets="300"

              >
    <map_option name="SolarSystemsLinkMethod" display_name="地图连接算法" description="地图的连接机制；控制地图连通性。">
      <choice_value id="0" display_name="太阳系" description="通过太阳系方法连接行星。" related_int_value="0" />
      <choice_value id="1" display_name="断裂" description="仅通过生成树连接行星。" related_int_value="1" />
      <choice_value id="3" display_name="蛛网" description="通过加布里埃尔图连接行星。" related_int_value="2" />
      <choice_value id="4" display_name="草垛" description="通过生成图连接行星。" related_int_value="3" />
    </map_option>
  </map_type>

       <map_type name="Nebula"
            display_name="星云"
            description="作为星团类别下的一个选项"
            dll_name="AIWarExternalDeepProcessingCode"
            type_name="Arcen.AIW2.External.Mapgen_Nebula"
            min_planets="40"
            max_planets="300"
            >
       <map_option name="NumberOfNebulae" display_name="星云数量" description="有多少个不同的星云">
