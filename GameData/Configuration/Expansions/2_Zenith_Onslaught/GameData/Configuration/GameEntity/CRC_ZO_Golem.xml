			uses_large_health_bar="true"
			category="Ship"
			size_scale="11.5"
			visuals_scale_multiplier="11"
			y_offset_of_icon="70"
			display_name="复仇巨像"
			display_name_for_sidebar="复仇GOL"
			description="极其耐用的巨像，能够反弹所受到的部分伤害并具有自我再生能力。"
			collision_priority="810"
			metal_to_claim="5000000"
			aip_to_claim="20"
			starting_mark_level="Mark1" tech_upgrades_that_benefit_me="UpgradeMeFromFleetOnly" tech_upgrade_that_is_used_for_my_direct_science="Direct_GolemGeneral"
			cost_for_ai_to_purchase="10000"			
			hull_points="3500000" shield_points="1500000" speed="AboveAverage1"
			metal_cost="5000000" energy_consumption="250000"
			assist_range="Normal1"			
			armor_mm="400" albedo="0.5" engine_gx="18" mass_tx="11"
			ship_or_structure_explosion_sfx="ShipLostMassive_Explosion"
			ship_or_structure_explosion_if_on_other_planet_sfx="ShipLargeLostOnOtherPlanet_Explosion"
			ship_or_structure_explosion_sfx_happens_if_not_mine_and_on_other_planet="true"
			shows_on_galaxy_map_for_explored_planets="true" always_visible_to_players="true"
