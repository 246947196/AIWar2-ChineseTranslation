      <choice_value id="1" display_name="每隔3个分支" description="每深入三个分支执行一次。" related_int_value="3" />
      <choice_value id="3" display_name="无" description="从不强制此设置" related_int_value="0" />
    </map_option>
    <map_option name="StartingSpacing" display_name="行星初始间距" description="最内层行星之间的距离有多远？这也会影响后续行星的间距，但影响程度取决于间距衰减。" default_id="2">
      <choice_value id="0" display_name="大" description="初始距离较大。" related_int_value="100" />
      <choice_value id="1" display_name="中" description="初始距离适中。" related_int_value="80" />
      <choice_value id="2" display_name="舒适" description="初始距离舒适。" related_int_value="60" />
      <choice_value id="3" display_name="小" description="初始距离较小。" related_int_value="40" />
      <choice_value id="4" display_name="微小" description="初始距离极小。在较高间距衰减下可能无法生成完整地图。" related_int_value="20" />
    </map_option>
    <map_option name="PlanetSpacingFalloff" display_name="行星间距衰减" description="随着你离中心越来越远，行星之间的距离会变小。但会变小多少呢？" default_id="3">
      <choice_value id="0" display_name="极大" description="极大的间距衰减。" related_int_value="300" />
      <choice_value id="1" display_name="大量" description="大量的间距衰减。" related_int_value="220" />
      <choice_value id="2" display_name="中等" description="中等的间距衰减。" related_int_value="180" />
      <choice_value id="3" display_name="较小" description="较小的间距衰减。" related_int_value="140" />
      <choice_value id="4" display_name="极小" description="极小的间距衰减。" related_int_value="120" />
      <choice_value id="5" display_name="无" description="完全没有衰减。" related_int_value="120" />
      <choice_value id="6" display_name="轻微反向" description="这实际上会让距离越远越长，而不是变短！" related_int_value="80" />
      <choice_value id="7" display_name="更多反向" description="这实际上会让距离越远明显更长，而不是变短！" related_int_value="60" />
    </map_option>
  </map_type>
