<?xml version="1.0" encoding="utf-8"?>
<root>
  <map_type name="CrazyBranching"
            display_name="疯狂分支"
            description="行星被组织成选定数量的不同群组，通过一个中央枢纽相连。除此之外，连接方式会变得更加疯狂，形成分支。大多数情况下，这里有不少关键节点可供探索！                在死亡愿望模式及更高难度下不可用。"
            dll_name="AIWarExternalDeepProcessingCode"
            type_name="Arcen.AIW2.External.Mapgen_CrazySymmetric"
            min_planets="40"
            max_planets="300"
            hidden_from_lists_above_harshness="2200">
    <map_option name="NumberOfGroups" display_name="群组数量" description="应该有多少个群组？" default_id="1">
      <choice_value id="0" display_name="两个" description="仅两个群组。" related_int_value="2" />
      <choice_value id="1" display_name="三个" description="三个群组。" related_int_value="3" />
      <choice_value id="2" display_name="四个" description="四个群组。" related_int_value="4" />
      <choice_value id="3" display_name="五个" description="五个群组。" related_int_value="5" />
      <choice_value id="4" display_name="六个" description="六个群组。" related_int_value="6" />
    </map_option>
    <map_option name="MinPlanetsPerBranch" display_name="每个分支的最小行星数" description="每个分支点允许的最小行星数是多少？如果你将此设置为等于或大于最大行星数，它将始终取两者中的最大值。" default_id="0">
      <choice_value id="0" display_name="两个" description="最小行星数为两个。" related_int_value="2" />
      <choice_value id="1" display_name="三个" description="最小行星数为三个。" related_int_value="3" />
      <choice_value id="2" display_name="四个" description="最小行星数为四个。" related_int_value="4" />
      <choice_value id="3" display_name="五个" description="最小行星数为五个。" related_int_value="5" />
      <choice_value id="4" display_name="六个" description="最小行星数为六个。" related_int_value="6" />
      <choice_value id="5" display_name="七个" description="最小行星数为七个。" related_int_value="7" />
      <choice_value id="6" display_name="八个" description="最小行星数为八个。" related_int_value="8" />
      <choice_value id="7" display_name="九个" description="最小行星数为九个。" related_int_value="9" />
      <choice_value id="8" display_name="十个" description="最小行星数为十个。" related_int_value="10" />
      <choice_value id="9" display_name="十一个" description="最小行星数为十一个。" related_int_value="11" />
    </map_option>
    <map_option name="MaxPlanetsPerBranch" display_name="每个分支的最大行星数" description="每个分支点允许的最大行星数是多少？如果你将此设置为等于或小于最小行星数，它将始终取两者中的最大值。" default_id="5">
      <choice_value id="0" display_name="两个" description="最大行星数为两个。" related_int_value="2" />
      <choice_value id="1" display_name="三个" description="最大行星数为三个。" related_int_value="3" />
      <choice_value id="2" display_name="四个" description="最大行星数为四个。" related_int_value="4" />
      <choice_value id="3" display_name="五个" description="最大行星数为五个。" related_int_value="5" />
      <choice_value id="4" display_name="六个" description="最大行星数为六个。" related_int_value="6" />
      <choice_value id="5" display_name="七个" description="最大行星数为七个。" related_int_value="7" />
      <choice_value id="6" display_name="八个" description="最大行星数为八个。" related_int_value="8" />
      <choice_value id="7" display_name="九个" description="最大行星数为九个。" related_int_value="9" />
      <choice_value id="8" display_name="十个" description="最大行星数为十个。" related_int_value="10" />
      <choice_value id="9" display_name="十一个" description="最大行星数为十一个。" related_int_value="11" />
    </map_option>
    <map_option name="ForceSinglePlanetEvery" display_name="每X个分支强制单个行星" description="每隔一定数量的分支，是否应该在继续之前只有一个子节点？" default_id="0">
