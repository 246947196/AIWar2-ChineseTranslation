<?xml version="1.0" encoding="utf-8"?>
<root>
  <map_type name="TheSquare"
            display_name="方格"
            description="一种集群风格的地图，但所有集群都呈网格状排列。
            
在死亡愿望模式及更高难度下不可用。"
            dll_name="AIWarExternalDeepProcessingCode"
            author_line="BadgerBadger"
            type_name="Arcen.AIW2.External.Mapgen_Nebula"
            min_planets="40"
            max_planets="300"
            hidden_from_lists_above_harshness="2200"
            >
    <map_option name="SquareLinkingStyle" display_name="整体连接风格" description="整个方格的连接机制。">
      <choice_value id="0" display_name="完整" description="通过加布里埃尔图连接行星。" related_int_value="0" />
      <choice_value id="1" display_name="间断" description="通过生成树图连接行星。" related_int_value="1" />
      <choice_value id="2" display_name="更多连接" description="通过带有额外连接的生成树图连接行星。" related_int_value="2" />
    </map_option>
    <map_option name="SquareIntraClusterLinkMethod" display_name="集群内连接风格" description="每个集群的连接机制。">
      <choice_value id="0" display_name="方格" description="行星以方格形式排列，并紧密连接。" related_int_value="0" />
      <choice_value id="1" display_name="随机" description="通过多种连接风格连接行星。" related_int_value="1" />
      <choice_value id="2" display_name="简单" description="通过相对邻域图连接行星。" related_int_value="2" />
      <choice_value id="3" display_name="捕梦网" description="通过加布里埃尔图连接行星。" related_int_value="3" />
      <choice_value id="4" display_name="星座" description="通过生成树图连接行星。" related_int_value="4" />

    </map_option>
    <map_option name="SquareSize" display_name="集群大小" description="集群应该多大？" default_id="3">
      <choice_value id="0" display_name="小" description="集群较小。" related_int_value="0" />
      <choice_value id="1" display_name="中" description="集群中等大小。" related_int_value="1" />
      <choice_value id="2" display_name="大" description="集群较大。" related_int_value="2" />
      <choice_value id="3" display_name="多样" description="集群大小范围广泛。" related_int_value="3" />
    </map_option>
  </map_type>

  <map_type name="Dissonance"
            display_name="不和谐"
            description="星系的某些区域行星丰富，而其他区域则没有行星。"
            dll_name="AIWarExternalDeepProcessingCode"
            author_line="BadgerBadger"
            type_name="Arcen.AIW2.External.Mapgen_Dissonance"
            min_planets="40"
            max_planets="300"
            >
    <map_option name="DissonanceConnectivity" display_name="不和谐连接性" description="这张地图的连接程度如何？" default_id="0" >
      <choice_value id="0" display_name="重叠" description="允许重叠，连接丰富。" related_int_value="0" />
      <choice_value id="1" display_name="中等" description="允许较少的连接，但不重叠。" related_int_value="1" />
      <choice_value id="2" display_name="稀疏" description="连接性非常低。" related_int_value="2" />
    </map_option>
  </map_type>


</root>
