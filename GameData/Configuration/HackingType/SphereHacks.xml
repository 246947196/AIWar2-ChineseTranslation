		response_strength_multiplier_per_time_hacked_same_target="1.2"
		cost_in_hacking_points="20"
		multiplier_to_hacking_point_cost_when_on_hostile_world="1.5"
		multiplier_to_hacking_time_when_on_neutral_or_friendly_world="0.5"
		hacking_points_against_this_faction_percentage_recorded_modifer="1"

		hack_duration="20"
		primary_hacking_response_interval="25"
		primary_response_strength_per_interval="2"
		secondary_hacking_response_interval="10"
		secondary_response_strength_per_interval="1"
		tertiary_hacking_response_interval="5"
		tertiary_response_strength_per_interval="0.25"
		response_strength_on_completion="1.0"
		local_hacker_required="true"
		hack_is_against_planet="false"
		use_closest_hacker_for_check="true"
		choose_a_specific_ship_line_to_grant="true"
		choice_text="你想为该黑客的舰队添加哪条单位生产线？"
		choice_text_height="60"
		destroy_hack_target_on_completion="false"
		relatedstring_is_a_ship_type="true"
/>
<!--For the above hack, the cost_in_hacking_points_multiplier_per_times_same_unit_hacked is bugged due to the sphere changing back and forth into antagonized state. Reduced from 1.5 to 1 because it doesn't apply correctly. Ship hack increased to 20 from 12 to compensate. -->


<!--	Making the sphere stronger -->

<item name="IncreaseSphereProduction" dll_name="AIWarExternalCode" type_name="Arcen.AIW2.External.Hacking_IncreaseSphereProduction" display_name="增加球体产量" 
        description="此黑客行为将使该球体的每秒预算增加 +200%，每次累加。
注意：当球体舰船容量低于 10% 时，其预算翻三倍。

球体会对干扰其系统感到愤怒。它最终会冷静下来，并可能成为一个有用的盟友。希望 AI 没有办法让它对我们产生敌意。"
        hack_duration="20"
        primary_hacking_response_interval="30"
        primary_response_strength_per_interval="0.75"
		secondary_hacking_response_interval="10"
		secondary_response_strength_per_interval="0.05"
        cost_in_hacking_points="20"
        response_strength_on_completion="1"
        local_hacker_required="true"
/>

