<item name="HackToGrantShipLine_Sphere" copy_from="HackToGrantShipLine" dll_name="AIWarExternalCode" type_name="Arcen.AIW2.External.Hacking_GrantShipLine_Sphere" 
          display_name="窃取戴森单位生产线" description="这将使玩家能够为破解旗舰（离目标最近的那艘）获取一条新的单位生产线。

此黑客行为将使戴森球在一段时间内对你产生敌意。"
		number_of_times_individual_unit_can_be_hacked="3"
		do_not_destroy_structure_after_hacking_multiple_times="true"
