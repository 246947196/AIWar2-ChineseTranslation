<?xml version="1.0" encoding="utf-8"?>
<root>
  <map_type name="Octopus"
            display_name="章鱼"
            description="一组中心行星，有多条“触手”从中心向外延伸。
              
在死亡愿望模式及以上不可用。"
            dll_name="AIWarExternalDeepProcessingCode"
            type_name="Arcen.AIW2.External.Mapgen_Octopus"
            author_line="Credit to tadrinth (some work from BadgerBadger)"
            min_planets="40"
            max_planets="300"
            hidden_from_lists_above_harshness="2200"
            >
    <map_option name="OctopusNumArms" display_name="触手数量" description="地图的连接机制；控制地图的连通性。" default_id="2">
      <choice_value id="0" display_name="两条" description="章鱼有两条触手。" related_int_value="2"/>
      <choice_value id="1" display_name="三条" description="章鱼有三条触手。" related_int_value="3"/>
      <choice_value id="2" display_name="四条" description="章鱼有四条触手。" related_int_value="4" />
      <choice_value id="3" display_name="五条" description="章鱼有五条触手。" related_int_value="5" />
      <choice_value id="4" display_name="六条" description="章鱼有六条触手。" related_int_value="6" />
      <choice_value id="5" display_name="七条" description="章鱼有七条触手。" related_int_value="7" />
      <choice_value id="6" display_name="八条" description="章鱼有八条触手。" related_int_value="8" />
    </map_option>
  </map_type>

  <!-- Solar systems Lite, Nebula and Asteroid still exist and the code works (or did last time I checked)
       but Keith didn't really like them. They are still defined though -->
  <map_type name="Solar_Systems_Lite"
            is_hidden="true"
              display_name="精简太阳系"
              description="暂无描述"
              dll_name="AIWarExternalDeepProcessingCode"
              type_name="Arcen.AIW2.External.Mapgen_Circles"
              min_planets="40"
              max_planets="300"

              >
    <map_option name="SolarSystemsLinkMethod" display_name="太阳系地图连接算法" description="太阳系地图的连接机制；控制地图的连通性。">
      <choice_value id="0" display_name="太阳系" description="通过太阳系方法连接行星。" related_int_value="0" />
      <choice_value id="1" display_name="晶洞" description="通过随机邻域图连接行星。" related_int_value="1" />
      <choice_value id="3" display_name="蜘蛛网" description="通过加布里埃尔图连接行星。" related_int_value="2" />
      <choice_value id="4" display_name="干草堆" description="通过生成树图连接行星。" related_int_value="3" />
    </map_option>
  </map_type>
     <map_type name="Nebula"
               is_hidden="true"
            display_name="星云"
            description="作为集群选项可用"
            dll_name="AIWarExternalDeepProcessingCode"
            type_name="Arcen.AIW2.External.Mapgen_Nebula"
            min_planets="40"
            max_planets="300"
            >
       <map_option name="NumberOfNebulae" display_name="星云数量" description="有多少不同的星云">
         <choice_value id="0" display_name="低" description="较少的星云或小行星集群。" related_int_value="0" />
         <choice_value id="1" display_name="中" description="中等数量的星云或小行星集群。" related_int_value="1" />
         <choice_value id="2" display_name="高" description="较多的星云或小行星集群。" related_int_value="2" />
       </map_option>
       <map_option name="NebulaeConnectivity" display_name="连通性类型" description="整体连通性水平">
         <choice_value id="0" display_name="低" description="较少的星云或小行星集群。" related_int_value="0" />
         <choice_value id="1" display_name="中" description="中等数量的星云或小行星集群。" related_int_value="1" />
         <choice_value id="2" display_name="高" description="较多的星云或小行星集群。" related_int_value="2" />
       </map_option>
  </map_type>
  <map_type name="Asteroid"
            is_hidden="true"
            display_name="小行星带"
            description="作为集群选项可用"
            dll_name="AIWarExternalDeepProcessingCode"
            type_name="Arcen.AIW2.External.Mapgen_Nebula"
            min_planets="40"
            max_planets="300"
            >
    <map_option name="NumberOfAsteroids" display_name="集群数量" description="创建多少个不同的小行星集群">
      <choice_value id="0" display_name="低" description="较少的星云或小行星集群。" related_int_value="0" />
      <choice_value id="1" display_name="中" description="中等数量的星云或小行星集群。" related_int_value="1" />
      <choice_value id="2" display_name="高" description="较多的星云或小行星集群。" related_int_value="2" />
    </map_option>
    <!--<map_option name="addBonusLinksAsteroid">
    </map_option>-->
  </map_type>



  <map_type name="Simple"
            display_name="简单"
            description="通用地图：行星均匀分布，并与最近的邻居相连。"
            dll_name="AIWarExternalDeepProcessingCode"
            type_name="Arcen.AIW2.External.Mapgen_Graph"
            author_line="感谢 BadgerBadger"
            min_planets="40"
            max_planets="300"
            sort_group="2"
              >
    <map_option name="SimpleLinkMethod" display_name="简单地图连接算法" description="简单地图的连接机制；控制行星之间的连接程度。" default_id="1">
      <choice_value id="0" display_name="简单" description="通过相对邻域图连接行星。" related_int_value="0" />
      <choice_value id="1" display_name="捕梦网" description="通过加布里埃尔图连接行星。" related_int_value="1" />
      <choice_value id="2" display_name="星座" description="通过生成树图连接行星。" related_int_value="2" />

    </map_option>
    <map_option name="SimplePointDistribution" display_name="行星布局" description="控制行星的基本布局。">
      <choice_value id="0" display_name="矩形" description="行星大致呈矩形排列。" related_int_value="0" />
      <choice_value id="1" display_name="小圆形" description="行星随机分布在小圆圈内。" related_int_value="1" />
      <choice_value id="2" display_name="大圆圈" description="行星随机分布在一个大圆圈内。" related_int_value="2" />
    </map_option>
  </map_type>
  <map_type name="Realistic"
            display_name="写实"
            is_default="true"
            description="感觉更杂乱且自然。"
            dll_name="AIWarExternalDeepProcessingCode"
            type_name="Arcen.AIW2.External.Mapgen_Graph"
            author_line="感谢 BadgerBadger"
            min_planets="40"
            max_planets="300"
            sort_group="1"
              >
    <map_option name="RealisticLinkMethod" display_name="写实地图连接算法" description="写实地图的连接机制；控制行星之间的连接程度。">
      <choice_value id="0" display_name="原始" description="使用相对较少的连接。" related_int_value="0" />
      <choice_value id="1" display_name="失忆" description="使用相对较少的连接。" related_int_value="1" />
      <choice_value id="2" display_name="旋风" description="使用许多连接。" related_int_value="2" />
    </map_option>
    <map_option name="RealisticPointDistribution" display_name="行星布局" description="控制行星的基本布局。">
      <choice_value id="0" display_name="矩形" description="行星大致呈矩形排列。" related_int_value="0" />
      <choice_value id="1" display_name="小圆形" description="行星随机分布在小圆圈内。" related_int_value="1" />
      <choice_value id="2" display_name="大圆圈" description="行星随机分布在一个大圆圈内。" related_int_value="2" />
    </map_option>
  </map_type>

