<?xml version="1.0" encoding="utf-8"?>
<root>

  <tutorial category="Basics" name="BasicGalacticControls" display_name="教程 2 - 基本星系控制" sort_priority="2"
        description="查看和移动单位在星系中的非常基本的控制方法。" scenario="AftermathOfLosingTheAIWar"
        do_not_serialize_setup_to_or_from_settings="true"
        skip_determine_ai_ownership="true" skip_determine_ai_homeworlds="true" skip_assign_player_homeworlds="true"
        force_map_type="Tutorial_01" force_map_seed="123456" skip_seed_special_entities="true"
        skip_all_galaxy_wide_capturables_and_obstacles="true" skip_warden_bases="true" skip_all_waves="true"
        debug_all_step_text_on_load="false"
   >
    <!--Setup for factions
        *************************************-->
    <!--You name any that you add beyond the built-in ones, or the following ones are built in:
        NaturalObject - owned by nobody
        AI - main AI
        FirstPlayer - presumably the only player, given this is a tutorial.
        PlayerBeyondTheFirst - any and all other players.
        AIWardenFleet - warden fleet of the main AI.
        AIHunterFleet - hunter fleet of the main AI.
        AntiAIZombie, AntiPlayerZombie, AntagonizedDysonSphere - all just kind of plumbing stuff.
        Instigators - the AI instigators.
        Outguard - the outguard, if there are any that seed, etc. -->
    <faction_initial_setup name="FirstPlayer" starting_planet_index="0"/>
    <faction_initial_setup name="PlayerBeyondTheFirst" do_not_add_faction="true"/>
    <faction_initial_setup name="Instigators" do_not_add_faction="true"/>
    <faction_initial_setup name="Outguard" do_not_add_faction="true"/>
    <faction_initial_setup name="AI">
        <custom_field key="AIType" val="Tutorial_01"/>
    </faction_initial_setup>
	<faction_initial_setup name="WardenFleet" do_not_add_faction="true"/>
	<faction_initial_setup name="HunterFleet" do_not_add_faction="true"/>
	

    <!--Setup for planet topography
        *************************************-->
    <!--Note that these tutorial planets allow you to define planets manually.  This ONLY works with the Tutorial_01 map type.
        If you want to have a tutorial in a regular other map type of some other sort, you can do so, but these won't be read in in terms of placement and names.-->
    <tutorial_planet name="Murdoch" x="0" y="0" is_blocked_to_npc_travel_via_wormholes="true"/>
    <tutorial_planet name="Midlander" x="100" y="-20" is_blocked_to_npc_travel_via_wormholes="true">
      <link name="Murdoch"/>
      <link name="Farland"/>
    </tutorial_planet>
    <tutorial_planet name="Farland" x="200" y="20" is_blocked_to_npc_travel_via_wormholes="true" is_blocked_to_player_travel_via_wormholes="true"/>
	<tutorial_planet name="Sidelander" x="-150" y="200" is_blocked_to_npc_travel_via_wormholes="true" is_blocked_to_player_travel_via_wormholes="true">
	  <link name="Murdoch"/>
	</tutorial_planet>



    <!--Setup for planet ownership, etc
        *************************************-->
    <!--Note that these work for even non-manually-created maps.  Ownerships are either whatever you named the factions above, 
        or are the built-in ones noted above.  You can match planets based on their added-index or their name.-->
    <planet_ownership_and_spawning match_index="0" linked_faction_name="FirstPlayer" is_homeworld="true"
          command_station_point="200,1000" skip_player_home_forcefield="true" skip_player_home_engineers="false"
          skip_player_home_factory="true" skip_player_home_human_settlement="true" skip_player_home_human_cryogenic_pods="true"
          skip_player_home_initial_combat_fleet="true" skip_player_home_initial_battlestation="true" skip_player_home_initial_support_fleet="true"
          initial_combat_fleet="ClassicStartingFleet" initial_battlestation_fleet="" initial_support_fleet=""
          number_of_metal_spots="4" >
    <ship_placement faction="FirstPlayer" type="RaidFrigate" placement_point="200,5000"/>
	<ship_placement faction="FirstPlayer" type="RaidFrigate" placement_point="1700,5000"/>
	<ship_placement faction="FirstPlayer" type="RaidFrigate" placement_point="200,6500"/>
	<ship_placement faction="FirstPlayer" type="RaidFrigate" placement_point="1700,6500"/>
    </planet_ownership_and_spawning>
    <planet_ownership_and_spawning match_name="Midlander" linked_faction_name="AI" mark_level_index="1"
            skip_ai_wormhole_sentinels="true" skip_ai_guardians="true" skip_ai_initial_turrets="true" skip_ai_guard_posts="true" skip_ai_initial_non_turret_defenses="true" skip_ai_initial_strikecraft="true"/>
			
    <planet_ownership_and_spawning match_name="Farland" linked_faction_name="AI" mark_level_index="5" is_homeworld="true" number_of_metal_spots="8"
            skip_ai_guard_posts="true" skip_ai_initial_non_turret_defenses="true" skip_ai_initial_strikecraft="true"/>
			
    <planet_ownership_and_spawning match_name="Sidelander" mark_level_index="1"  number_of_metal_spots="8"
            skip_ai_wormhole_sentinels="true" skip_ai_guardians="true" skip_ai_initial_turrets="true" skip_ai_guard_posts="true" skip_ai_initial_non_turret_defenses="true" skip_ai_initial_strikecraft="true"/>			

    <!--Actual steps of the tutorial itself!
    
      For informaton about the conditions that you can use, and how to use them, 
      please see this wiki page: https://wiki.arcengames.com/index.php?title=AI_War_2:_Tutorial_Step_Conditions
      *************************************-->
    <tutorial_step text_to_show="欢迎来到《AI战争2》的第二个教程。本教程将介绍如何使用星系地图，查看不同的行星，以及在行星之间移动我们的单位。
	
目前，我们正在查看我们的起始行星。我们想要查看星系地图，可以通过两种不同的方式实现：

我们可以按键盘上的TAB键，或者点击左上角的当前行星名称。">
      <condition type="PlayerViewIsOnGalaxyMap"/>
    </tutorial_step>
	
    <tutorial_step text_to_show="这就是星系。目前没有太多可以看到的东西。你可以像在行星视图中一样在这个屏幕上移动。当前选中的行星会被白色圆圈高亮显示。
	
要查看行星的名称，请按住CTRL键。如果你希望这个功能永久开启，可以在设置中找到相应选项。

我们想要将视图切换到{c1.PlanetName}。要这样做，点击它进行选择，然后按TAB或再次点击左上角。

&lt;color=#999999&gt;额外提示1：你也可以通过双击行星来将视图切换到该行星。&lt;/color&gt;

&lt;color=#999999&gt;额外提示2：还有第三种方法 - 按住CTRL并左键点击行星。结合CTRL显示行星名称的功能，这可以快速前往特定行星。&lt;/color&gt;">	
      <condition type="PlayerViewIsOnSpecificPlanet" planet_by_name="米德兰德"/>
    </tutorial_step>	

    <tutorial_step text_to_show="现在我们在查看一个AI控制的行星。我们打算尝试攻击这里，但首先我们需要回到{c1.PlanetName}并选择我们的护卫舰。
	
你可能已经注意到在行星周围有一些东西。这些是虫洞 - 每个行星都通过这些虫洞链接，单位通过它们在星系中移动。

它们也是切换我们查看行星的另一种方式。要使用这种方式回到{c1.PlanetName}，按住CTRL并点击通向那里的虫洞。">
      <condition type="PlayerViewIsOnSpecificPlanet" planet_by_name="默多克"/>
    </tutorial_step>
		
    <tutorial_step text_to_show="现在选择其中一艘护卫舰。我们将把它送过虫洞。
	
有两种方法，一种我们可以在这个视图中完成，另一种在星系地图上完成。对于这艘护卫舰，我们将使用第一种方法。

就像我们通过CTRL和点击发送我们的视图一样，我们可以通过按住CTRL并右键点击虫洞来发送这个单位。

使用这种方法将我们选择的护卫舰送到{c1.PlanetName}，然后送你的视图过去并等待它。">
      <condition type="PlayerViewIsOnSpecificPlanet" planet_by_name="米德兰德"/>
	  <condition type="PlayerHasCountOfSpecificShipOnPlanet" planet_by_name="米德兰德" entity_type="RaidFrigate" count="1"/>
    </tutorial_step>
	
    <tutorial_step text_to_show="这里有一些敌人，所以我们可能也需要我们的其他护卫舰。现在我们将尝试另一种方法，使用我们留在后面的护卫舰。
	
首先将你的视图返回到我们来的行星，选择我们留在那里的所有3艘护卫舰，然后返回星系地图。

记住，你可以使用TAB按钮或点击左上角的当前行星名称来在行星视图和星系地图视图之间切换。

&lt;color=#999999&gt;额外提示：按键盘上的M按钮将选择当前行星上的所有军事舰船。&lt;/color&gt;">
      <condition type="PlayerViewIsOnGalaxyMap"/>
	  <condition type="PlayerHasSelectedCountOfSpecificShip" entity_type="RaidFrigate" count="3"/>
    </tutorial_step>	

    <tutorial_step text_to_show="你可能注意到在右下角我们仍然选中了我们的护卫舰。我们想把它们送到{c1.PlanetName}，即我们送第一艘护卫舰去的AI控制的行星。
	
我们所需要做的，就是简单地右键点击{c1.PlanetName}。我们的护卫舰将前往虫洞并出现在另一边。

&lt;color=#999999&gt;额外提示1：当你选择了单位并将鼠标悬停在行星上时，如果你命令它们前往那里，将会显示它们的预期路径。&lt;/color&gt;

&lt;color=#999999&gt;额外提示2：你也可以不仅仅命令护卫舰前往{c1.PlanetName}，而是先将你的视图发送到那里，然后给出移动或攻击命令，即使护卫舰还不在那里。它们会前往该行星，然后在到达后执行给定的命令。&lt;/color&gt;">
      <condition type="PlayerHasCountOfSpecificShipOnPlanet" planet_by_name="米德兰德" entity_type="RaidFrigate" count="3"/>
    </tutorial_step>
  </tutorial>	

</root>