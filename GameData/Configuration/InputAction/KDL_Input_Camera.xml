      category="Camera" display_name="返回上一相机视角"
      description="返回上一个相机视角。在点击警报查看行星后，可用于返回工作视角。"
      check_type="ButtonPress" key="None" />
  <input_action name="CameraNavigateForward"
      category="Camera" display_name="前往下一相机视角"
      description="通常此操作无效果，但如果您使用过“返回上一相机视角”，则此操作可撤销该动作。"
      check_type="ButtonPress" key="None" />
-->

</root>