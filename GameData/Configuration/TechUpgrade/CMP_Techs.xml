<?xml version="1.0" encoding="utf-8"?>
<root>
  <item name="Unused" display_name="无法升级。" is_visible_on_menus="false" sort_group="1" sort_index="1" is_considered_blank="true"/>
  <item name="UpgradeMeFromFleetOnly" short_name="Fleet" display_name="仅当上级舰队升级时才会升级。" sort_group="2" sort_index="2" is_visible_on_menus="false" is_considered_blank="true"/>

  <item name="Splash" short_name="Splash" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 溅射武器" science_cost_per_time_unlocked="1500,2750,5000,6750" icon_path="assets/sci-fi_game_icons/icons/png/transparent/13_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="溅射型舰船通常用于群体控制，通过聚焦光束或范围效果攻击多个目标。可能是区域内的破片伤害摧毁低装甲目标，也可能是具有多种效果的大规模电击放电。"/>
  <item name="Concussion" short_name="Artillery" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 火炮武器" science_cost_per_time_unlocked="1500,2750,5000,6750" icon_path="assets/sci-fi_game_icons/icons/png/transparent/12_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="火炮舰船通常发射震荡定向装药，射程中等至较远。大多数单位适合围攻，擅长消灭低装甲目标。许多还具有击退效果，可以阻止小型敌人还击。"/>
  <item name="Fusion" short_name="Pierce" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 穿透武器" science_cost_per_time_unlocked="1500,2750,5000,6750" icon_path="assets/sci-fi_game_icons/icons/png/transparent/97_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="穿透型舰船如轰炸机或刺鳐，专注于以某种方式攻击护盾。聚变式穿透舰船(轰炸机)能够绕过目标的个人护盾直接攻击船体。它们主要针对大型或有护盾的目标。其他穿透舰船主要用于摧毁力场护盾，轰炸机对此没有额外加成。"/>
  <item name="Raid" short_name="Raid" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 突袭武器" science_cost_per_time_unlocked="1500,2750,5000,6750" icon_path="assets/sci-fi_game_icons/icons/png/transparent/61_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="突袭型舰船通常牺牲船体完整性换取速度和攻击力。这些单位不适合正面战斗，但非常适合突袭和打了就跑的战术。就炮塔而言，大多数突袭型炮塔造价低廉且防御薄弱，但建造迅速且威力强大。"/>
  <item name="Melee" short_name="Melee" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 近战武器" science_cost_per_time_unlocked="1500,2750,5000,6750" icon_path="assets/sci-fi_game_icons/icons/png/transparent/57_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="近战型舰船包括所有专注于快速接近目标并将其摧毁或切割的近战单位。同时也包括各种专注于点防御的极短程危险炮塔和其他单位。"/>
  <item name="Disruptive" short_name="Disrupt" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 干扰武器" science_cost_per_time_unlocked="1500,2750,5000,6750" icon_path="assets/sci-fi_game_icons/icons/png/transparent/99_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="干扰型舰船种类繁多，但都针对特定目标。有些针对极低装甲舰船，有些针对极高装甲目标。还有些使用武器干扰或牵引光束阻止敌人行动。它们都专注于利用特殊弱点。"/>
  <item name="Technologist" short_name="Exotic" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 异种武器" science_cost_per_time_unlocked="1500,2750,5000,6750"  icon_path="assets/sci-fi_game_icons/icons/png/transparent/20_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="异种武器舰船是实验性的，通常较为脆弱。但它们包括像寄生虫(用于接管敌舰)这样的珍品。总体来说这些涉及大量电子战。"/>
  <item name="Generalist" short_name="Core" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 核心武器" science_cost_per_time_unlocked="1500,2750,5000,6750" icon_path="assets/sci-fi_game_icons/icons/png/transparent/2_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="核心武器舰船通常是多面手，用于'战线'或掩护目的。传统的弹道武器和简单定向能量武器并不特别华丽但很实用。使用这些系统的舰船非常适合支援或成为有效舰队的骨干。"/>
  <item name="Ambush" short_name="Ambush" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 伏击武器" science_cost_per_time_unlocked="1500,2750,5000,6750" icon_path="assets/sci-fi_game_icons/icons/png/transparent/58_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="伏击型舰船主要特点是利用时间优势。例如'对已在星球X秒的单位造成额外伤害'，或首次抵达星球时的加成。总体来说这些舰船以某种方式利用环境优势。也包括像狙击单位这样利用敌人速度对付他们自己的单位。"/>
  <item name="Subterfuge" short_name="Subtle" sort_group="20" sort_index="1" display_name="&lt;color=#ffb37b&gt;Weapon:&lt;/color&gt; 诡计武器" science_cost_per_time_unlocked="1500,2750,5000,6750" icon_path="assets/sci-fi_game_icons/icons/png/transparent/107_b.png" weapon_upgrade="true" tags="Weapon" for_player_type_tags="HumanEmpire"
        description="诡计武器舰船通常隐形，但不总是如此。许多会施加减益效果，如暂时禁用引擎。少数是巨人杀手，专注于对大型目标造成毁灭性打击。"/>
  
  <item name="Light" short_name="Light" sort_group="50" sort_index="100" display_name="&lt;color=#fa7bff&gt;Hull:&lt;/color&gt; 轻型船体" science_cost_per_time_unlocked="4000,6000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/8_b.png" tags="Hull,HullStandard" for_player_type_tags="HumanEmpire"
        description="轻型舰船有各种尺寸和能力，但通常装甲较少。这不是问题，除非面对专门针对低装甲的敌人武器。"/>
  <item name="Medium" short_name="Medium" sort_group="50" sort_index="200" display_name="&lt;color=#fa7bff&gt;Hull:&lt;/color&gt; 中型船体" science_cost_per_time_unlocked="4000,6000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/18_b.png" tags="Hull,HullStandard" for_player_type_tags="HumanEmpire"
        description="中型舰船有各种尺寸和能力，但通常装甲量中等。这类舰船较少，但不太可能成为针对高或低装甲评级的加成目标。"/>
  <item name="Heavy" short_name="Heavy" sort_group="50" sort_index="300" display_name="&lt;color=#fa7bff&gt;Hull:&lt;/color&gt; 重型船体" science_cost_per_time_unlocked="4000,6000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/25_b.png" tags="Hull,HullStandard" for_player_type_tags="HumanEmpire"
        description="重型舰船有各种尺寸和能力，但通常装甲量从大到非常大。高装甲量不会带来任何自然加成，但往往与高船体生命值同时存在。有一些专门的高装甲杀手单位，但除此之外很少有舰船对它们有加成。"/>
  <item name="Turret" short_name="Turret" sort_group="50" sort_index="400" display_name="&lt;color=#fa7bff&gt;Hull:&lt;/color&gt; 炮塔" science_cost_per_time_unlocked="5000,9000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/42_b.png" tags="Hull,HullTurret,SpecialBonus" for_player_type_tags="HumanEmpire"
        description="炮塔是没人费心加装引擎的武器。它们通常由指挥站、战斗站或要塞建造。一般在友方领土，但也可用于进攻滩头阵地。"/>
  <item name="Alien" short_name="Alien" sort_group="50" sort_index="500" display_name="&lt;color=#fa7bff&gt;Hull:&lt;/color&gt; 外星船体" science_cost_per_time_unlocked="1000,2500,4000,5500,7000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/50_b.png" tags="Hull,HullOtherFaction" for_player_type_tags="HumanEmpire"
        skips_rejection_if_benefits_nothing="true"
      description="除非你专门入侵某些派系获取，否则不太可能遇到外星船体。受益的舰船可能极其强大且形态功能多样。仅影响直接由你指挥的外星舰船，不影响盟友派系。"/>
  <item name="Expatriate" short_name="Expat" sort_group="50" sort_index="600" display_name="&lt;color=#fa7bff&gt;Hull:&lt;/color&gt; 流亡船体" science_cost_per_time_unlocked="1000,2500,4000,5500,7000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/108_b.png" tags="Hull,HullOtherFaction" for_player_type_tags="HumanEmpire"
        skips_rejection_if_benefits_nothing="true"
      description="除非你专门入侵某些派系获取，否则不太可能遇到流亡船体。受益的舰船可能与你的很相似，但存在差异。大多数不在星球上的人类已加入你的战争，但有些团体因各种原因拒绝完全加入。统称为流亡者。影响所有Outguards和HRF舰船，但通常不影响其他盟友派系。"/>

  <item name="Engineering" short_name="Engineer" sort_group="60" sort_index="410" display_name="&lt;color=#f7fe8d&gt;Civilian:&lt;/color&gt; 工程学" science_cost_per_time_unlocked="1000,1500,2000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/1_b.png" tags="Civilian" for_player_type_tags="HumanEmpire"
        description="提升从指挥站或某些移动工厂建造的工程师的效率和耐久性。工程师达到3级后还会获得隐形能力，在危险区域使用工程师时极其有用。"
      >
      <cost_override
          min_campaign_harshness_to_apply="0" max_campaign_harshness_to_apply="9999"
          only_applies_if_setting_is_on="EngineeringUpgradesCostMore"
          science_cost_per_time_unlocked="1500,2500,4000"/>
  </item>
  <item name="MetalGeneration" short_name="Mining" sort_group="60" sort_index="430" display_name="&lt;color=#f7fe8d&gt;Civilian:&lt;/color&gt; 轨道采矿" science_cost_per_time_unlocked="3000,3000,3000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/106_b.png" tags="Civilian" for_player_type_tags="HumanEmpire"
        description="早期可考虑直接升级主星指挥站舰队(通过舰队侧边栏标签)以获得更强收益。轨道采矿科技在拥有多个星球时更有效。这会提升主星上少数结构的效率，以及你在每个星球建造的所有金属采集器效率，仅此而已。"/>
  
  <item name="CommandEconomic" short_name="Economic" sort_group="70" sort_index="420" display_name="&lt;color=#7bffcc&gt;Command:&lt;/color&gt; 经济型" science_cost_per_time_unlocked="2000,2750,3500,4000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/15_b.png" tags="Command,SpecialBonus" for_player_type_tags="HumanEmpire"
        description="当你拥有大量此类指挥站时很有用。或者考虑直接投资每个星球的舰队(舰队侧边栏)，因为这也会升级当地的金属采集器和炮塔。此科技提升你所有经济型指挥站，主要是增加金属和能量产量，以及一些额外坚固性。"/>
  <item name="CommandMilitary" short_name="Military" sort_group="70" sort_index="430" display_name="&lt;color=#7bffcc&gt;Command:&lt;/color&gt; 军事型" science_cost_per_time_unlocked="2000,3000,4000,5000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/5_b.png" tags="Command,SpecialBonus" for_player_type_tags="HumanEmpire"
        description="当你拥有大量此类指挥站时很有用。或者考虑直接投资每个星球的舰队(舰队侧边栏)，因为这也会升级当地的金属采集器和炮塔。此科技提升你所有军事型指挥站，主要是增加攻击力和船体生命值。"/>
  <item name="CommandLogistical" short_name="Logistic" sort_group="70" sort_index="440" display_name="&lt;color=#7bffcc&gt;Command:&lt;/color&gt; 后勤型" science_cost_per_time_unlocked="1500,1500,3000,3000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/28_b.png" tags="Command,SpecialBonus" for_player_type_tags="HumanEmpire"
        description="当你拥有大量此类指挥站时很有用。或者考虑直接投资每个星球的舰队(舰队侧边栏)，因为这也会升级当地的金属采集器和炮塔。此科技提升你所有后勤型指挥站，结合经济和军事优势，并为所在星球所有盟友舰船提供大幅速度加成。"/>
  
  <item name="Forcefields" short_name="Forcefield" sort_group="80" sort_index="400" display_name="&lt;color=#908dfe&gt;Defense:&lt;/color&gt; 力场" science_cost_per_time_unlocked="1500,1500,2250,2250,3000,3000" icon_path="assets/sci-fi_game_icons/icons/png/transparent/24_b.png" tags="Defense" for_player_type_tags="HumanEmpire"
        description="升级你在各指挥站建造的所有气泡力场。同时改进移动式气泡力场发生器(力场护卫舰等)。"/>
  <item name="Citadels" short_name="M.Fort" sort_group="80" sort_index="410" display_name="&lt;color=#908dfe&gt;Defense:&lt;/color&gt; 移动要塞" science_cost_per_time_unlocked="1500,2300,2600,2800" icon_path="assets/sci-fi_game_icons/icons/png/transparent/9_b.png" tags="Defense,SpecialBonus" for_player_type_tags="HumanEmpire"
        description="升级你可能拥有或获得的任何战斗站或要塞。这些结构允许你在自己的星球或敌人的星球上作为'滩头阵地'建造额外的防御炮塔、地雷等。"/>
  <item name="Minefields" short_name="Minefield" sort_group="80" sort_index="420" display_name="&lt;color=#908dfe&gt;Defense:&lt;/color&gt; 雷区" science_cost_per_time_unlocked="600,1250,2250,3500" icon_path="assets/sci-fi_game_icons/icons/png/transparent/88_b.png" tags="Defense" for_player_type_tags="HumanEmpire"
        description="雷区由指挥站、战斗站或要塞建造。它们并不常见，所以你可能只想在确定会拥有它们时才投资。"/>
  <item name="Sentries" short_name="St.Keeper" sort_group="80" sort_index="430" display_name="&lt;color=#908dfe&gt;Defense:&lt;/color&gt; 站台守卫" science_cost_per_time_unlocked="500,1000,2000,2500" icon_path="assets/sci-fi_game_icons/icons/png/transparent/73_b.png" tags="Defense,SpecialBonus" for_player_type_tags="HumanEmpire"
        description="站台守卫通常是绑定在特定星球重力井的移动护卫舰。它们作为舰队的一部分帮助防御指挥站。"/>

</root>