<?xml version="1.0" encoding="utf-8"?>

<root>
  <faction name="Human" display_name="玩家派系" short_name="Human" processing_group="Human"
           custom_NameForSorting="_1"
           custom_NameForLobby="额外&lt;color=#318CE7>玩家&lt;/color>派系"
           team_center_color="c318CE7" team_border_color="cF2F3F4"
           team_center_colors_beyond_the_first="c007FFF,cFFC40C,cCF3476"
           team_border_colors_beyond_the_first="Turquoise,cFFFDD0,cFFA6C9" 
           
           icon_name_for_lobby="Ships1/King"

           type="Player" does_player_style_ship_upgrades="true"
           description="玩家派系的功能根据所选玩家类型而有很大差异。"
           counts_as_part_of_player_strength_at_planet_for_counterattack_blocking="true"
           is_allowed_to_auto_seed_in_tutorial="true"
           sort_group="100"
  >
    <!-- Global field for any human player type. -->
    <custom_field
          name="PlayerType" display_name="玩家类型" related_table="PlayerTypeData" description="您要扮演什么类型的玩家？传统的人类帝国、观察者，还是更奇特的角色？"
	    sort_group="10" setting_type="CustomDropdownCoreTable" default_option="HumanEmpire"
            requires_mark_as_changed="true"
            />

    <!-- Human Empire custom fields. -->
    <custom_field requires_player_types="HumanEmpire,SpireInfusedEmpire"
          name="StartingFleet" display_name="初始舰队" related_table="InitialPlayerFleets" description="选择该人类派系进攻行动的初始旗舰。"
          sort_group="200" setting_type="CustomDropdownCoreTableSubset" default_option="ClassicStartingFleet"
          random_option_name="RandomCombatFleet" random_option_display_name="&lt;color=#ffd965&gt;随机&lt;/color&gt;" random_option_description="随机选择一个初始战斗舰队。"/>
    <custom_field requires_player_types="HumanEmpire,SpireInfusedEmpire"
          name="StartingBattlestation1" display_name="初始机动平台1" related_table="InitialPlayerBattlestations" 
          description="选择该人类派系防御的第一个机动平台。它将在战役过程中大幅扩展，但这将决定您在游戏初期可用的内容。"
          sort_group="210" setting_type="CustomDropdownCoreTableSubset" default_option="RandomBattlestation"
          random_option_name="RandomBattlestation" random_option_display_name="&lt;color=#ffd965&gt;随机&lt;/color&gt;" random_option_description="随机选择一个初始机动平台。" />
    <custom_field requires_player_types="HumanEmpire,SpireInfusedEmpire"
          name="StartingBattlestation2" display_name="初始机动平台2" related_table="InitialPlayerBattlestations" 
          description="选择该人类派系防御的第二个机动平台。它将在战役过程中大幅扩展，但这将决定您在游戏初期可用的内容。"
          max_campaign_harshness_to_display="700"
          sort_group="215" setting_type="CustomDropdownCoreTableSubset" default_option="RandomBattlestation"
          random_option_name="RandomBattlestation" random_option_display_name="&lt;color=#ffd965&gt;随机&lt;/color&gt;" random_option_description="随机选择一个初始机动平台。" />
    <custom_field requires_player_types="HumanEmpire,SpireInfusedEmpire"
          name="StartingSupportFleet" display_name="初始支援舰队" related_table="InitialPlayerSupportFleets" description="选择该人类派系的初始支援舰队。"
          sort_group="220" setting_type="CustomDropdownCoreTableSubset" default_option="StartingCombatEngineerAndFactoryCombo" 
          random_option_name="RandomSupportFleet" random_option_display_name="&lt;color=#ffd965&gt;随机&lt;/color&gt;" random_option_description="随机选择一个初始支援舰队。" />
    <custom_field requires_player_types="HumanEmpire,SpireInfusedEmpire"
          name="HumanCryogenicPodsToStartWith" is_advanced_setting="true" display_name="&lt;color=#ff7e64&gt;高级:&lt;/color&gt; 冷冻舱数量"
          sort_group="300" setting_type="IntSlider" default="25" min="0" max="30" default_should_override_user_value_if_older_than_version="2748_DefaultUpdates"
          max_campaign_harshness_to_display="200" fixed_value_if_above_campaign_harshness="25" sandbox_max="50"
          description="在该派系的母星上，可以放置一些人类冷冻舱。它们会大幅提升您的能量产出，特别是在游戏初期，但它们非常脆弱，如果被摧毁会使AI进度增加1。

您在风险/回报谱系中的位置以及您对保卫母星的信心程度，将真正决定您是需要默认的25个、更多，还是完全不需要。" />
    <custom_field requires_player_types="HumanEmpire,SpireInfusedEmpire"
          name="HomeHumanSettlementsToStartWith" is_advanced_setting="true" display_name="&lt;color=#ff7e64&gt;高级:&lt;/color&gt; 初始定居点数量"
          sort_group="310" setting_type="IntSlider" default="4" min="0" max="5" default_should_override_user_value_if_older_than_version="2748_DefaultUpdates"
          max_campaign_harshness_to_display="200" fixed_value_if_above_campaign_harshness="4" sandbox_max="15"
          description="在该派系的母星上，可以放置一些人类定居点。它们会大幅提升您的金属收入，特别是在游戏初期，但它们相当脆弱，如果被摧毁会使AI进度增加5。

您在风险/回报谱系中的位置以及您对保卫母星的信心程度，将真正决定您是需要默认的4个、更多，还是完全不需要。" />

    <!-- Later-in global fields for all player types. -->
    <custom_field  requires_player_types="HumanEmpire,SpireInfusedEmpire"
          name="StartingMetal" is_advanced_setting="true" display_name="&lt;color=#ff7e64&gt;高级:&lt;/color&gt; 初始金属"
          sort_group="410" setting_type="IntTextbox" default="2500000" min="0" max="2500000"
          max_campaign_harshness_to_display="200" fixed_value_if_above_campaign_harshness="2500000" sandbox_max="2500000"
          description="该玩家开始时有多少金属？默认是250万(这也是最大值，因为初始指挥站的存储容量无法容纳更多)。开始时有更多或更少金属对游戏平衡影响不大。" />
    <custom_field  requires_player_types="HumanEmpire,SpireInfusedEmpire"
          name="StartingScience" is_advanced_setting="true" display_name="&lt;color=#ff7e64&gt;高级:&lt;/color&gt; 初始科技"
          sort_group="420" setting_type="IntTextbox" default="15000" min="0" max="50000"
          max_campaign_harshness_to_display="200" fixed_value_if_above_campaign_harshness="12000" sandbox_max="500000"
          description="该玩家开始时有多少科技？默认是1.5万。开始时有更多科技被视为作弊，但你可以设置最多5万。" />
    <custom_field  requires_player_types="HumanEmpire,SpireInfusedEmpire"
          name="StartingHacking" is_advanced_setting="true" display_name="&lt;color=#ff7e64&gt;高级:&lt;/color&gt; 初始入侵点数"
          sort_group="430" setting_type="IntTextbox" default="60" min="0" max="120"
          max_campaign_harshness_to_display="200" fixed_value_if_above_campaign_harshness="48" sandbox_max="5000"
          description="该玩家开始时有多少入侵点数(HaP)？默认是60。开始时有更多点数被视为作弊，但你可以设置最多120。" />
  </faction>  
    
  <faction name="DevourerGolem"
           display_name="吞噬者傀儡" short_name="Devourer" processing_group="LoneWanderer"
           base_info_source="DevourerFactionBaseInfo"
           deep_info_source="DevourerFactionDeepInfo"
           team_center_color="c191970" team_border_color="c00FF7F"
           type="SpecialFaction"
           ai_can_send_waves_against_this="false"
           ai_does_not_generate_threat_against="true"
           description="几乎不可摧毁的吞噬者傀儡在银河系中缓慢移动，吸收它发现的所有机动军事力量来为自己提供能量和修复。
           
此外，如果它访问的行星上有任何停火协议，只要吞噬者在场，停火协议就会失效。
		   
&lt;color=#f25e1c&gt;低影响:&lt;/color&gt; 这个派系不会扩张，也不会造成任何不可修复的损害。但有时会在战斗中造成巨大的局势转变。"
           ai_threat_against_this_faction_goes_back_to_guarding="true"
           impact="Easier"
           RequiresMinorFactionTeammates="true"
           CanBeFriendlyToPlayer="true"
           CanBeHostileToAll="true"
           CanBeOnMinorFactionTeam="true"
           icon_name_for_lobby="Ships1/DevourerGolem"
           >
    <custom_field name="Allegiance" display_name="派系立场" description="这个派系对AI、人类还是中立？"
          sort_group="200" setting_type="CustomDropdownArbitraryOptions" arbitrary_options="对所有敌对,对玩家友好,仅对玩家敌对,小派系小队红,小派系小队蓝,小派系小队绿" default_option="对所有敌对" />
  </faction>
  
  <faction name="ZenithDysonSphere"
            custom_NameForLobby="戴森球: &lt;color=#324AB2&gt;天顶&lt;/color&gt;"
           display_name="天顶戴森球" short_name="Zenith Sphere" processing_group="ZenithDysonSphere"
           base_info_source="SphereFactionBaseInfo"
           deep_info_source="SphereFactionDeepInfo"
           templar_avoids_me="true"
           team_center_color="c324AB2" team_border_color="c90EE90"
           type="SpecialFaction" is_immune_to_reconquest_waves="true"
           description="巨大的戴森球傀儡存在于AI的一个行星上，本质上是一个巨大的堡垒，会同时攻击人类和AI。然而，如果你将行星从AI手中解放出来，戴森球会意识到你的善意，并会帮助你攻击附近行星上的AI。如果你自己占领了这个行星，戴森球会攻击你直到你放弃这个行星。
		   
&lt;color=#f25e1c&gt;中等影响:&lt;/color&gt; 这个派系不会扩张，也不会造成任何不可修复的损害。它可以被提升到比初始状态高得多的水平，但如果开局不利，有时可能会显得有点弱。"
           ai_threat_against_this_faction_goes_back_to_guarding="true"
           impact="Moderate"
           ai_should_not_have_hunter_against_this="true"
           CanBeFriendlyToPlayer="true"
           icon_name_for_lobby="Ships1/Dyson_Sphere"
           exclude_from_za_territory="true"
  >
    <npc_ship_cap name="Strikecraft" overriding_per_faction_cap_of_stacks="500" />
    <custom_field name="Intensity" display_name="强度" description="它们可能对游戏进程产生多大影响？
	建议在AI难度较高或有更多派系时将此值从5提高。
	当强度达到8+时，AI的戴森敌对行为会定期出现。"
          sort_group="200" setting_type="IntSlider" default="5" min="1" max="10"/>
  </faction>

  <faction name="ZenithTrader"
           display_name="天顶商人" short_name="Z Trader" processing_group="LoneWanderer"
           base_info_source="ZenithTraderFactionBaseInfo"
           deep_info_source="ZenithTraderFactionDeepInfo"
           team_center_color="c1560BD" team_border_color="c2E8B57"
           type="SpecialFaction"
           allegiance_should_always_be_friendly_to_all="true"
           description="这些外星商人乐意与任何能付得起钱的人做生意。他们在银河系中旅行，为人类和AI玩家提供特殊建筑(收费昂贵)。
           
它访问的行星上会形成临时停火，这可能是好事(如果你需要休息)也可能是坏事(如果你的敌人需要休息)。
		   
&lt;color=#f25e1c&gt;低影响:&lt;/color&gt; 这个派系不会扩张，也不是战斗单位。可能有所帮助，也可能造成阻碍，或者两者兼有，但通常影响不大。"
           impact="Easier"
           CanBeFriendlyToPlayer="true"
           icon_name_for_lobby="Ships1/Zenith_Trader"
  >
  </faction>
  
    <faction name="HumanResistanceFighters"
           display_name="人类抵抗军" short_name="Human Resistance" processing_group="HumanResistanceFighters"
           base_info_source="HumanResistanceFighterFactionBaseInfo"
           deep_info_source="HumanResistanceFighterFactionDeepInfo"
           team_center_color="c00563B" team_border_color="cBFFF00"
           type="SpecialFaction" does_player_style_ship_upgrades="true"
           must_be_at_most_one="true"
           counts_as_part_of_player_strength_at_planet_for_counterattack_blocking="true"
           description="人类抵抗军(HRF)是仍然生活在AI行星周围深空的人类的盟友；当他们看到你与AI战斗时，有时会现身加入你。
		   
&lt;color=#f25e1c&gt;低影响:&lt;/color&gt; 这个派系不会扩张，也不会造成任何不可修复的损害。他们能增强你的力量，但不会为你赢得游戏。"
           impact="Easier"
           CanBeFriendlyToPlayer="true"
           icon_name_for_lobby="Ships1/AdvancedResearchStation"
           >
      <custom_field name="Intensity" display_name="强度" description="通常这是一个中等强度的派系，可以提供帮助但不会单独改变游戏进程。然而在较高强度下，如果AI没有一些盟友来平衡，它能从战斗中恢复用于未来的部队数量可能会过多。"
          sort_group="200" setting_type="IntSlider" default="5" min="1" max="10"/>
  </faction>
  
    <faction name="HumanMarauders"
           display_name="掠夺者" short_name="Marauders" processing_group="HumanMarauders"
           base_info_source="MarauderFactionBaseInfo"
           deep_info_source="MarauderFactionDeepInfo"
           team_center_color="c00563B" team_border_color="cFF5A36"
           type="SpecialFaction"
           description="生活在深空的敌对人类流浪者会偶尔通过传统推进方式袭击人类或AI行星(因此从系统边缘进入，而非虫洞)。如果他们占领了一个行星，就会加强防御并利用其资源强化未来的攻击。更高的强度会使这个派系的攻击更强大和频繁。
		   
&lt;color=#f25e1c&gt;可变影响:&lt;/color&gt; 这个派系会扩张，并能造成不可修复的损害。如果允许他们充分扩张，可能成为巨大威胁，但初期发展可能较困难。他们独特的攻击方式会迫使玩家采用不同的策略。"
           can_use_spire_debris="true"
           impact="Moderate"
           CanBeFriendlyToPlayer="true"
           CanBeHostileToAll="true"
           CanBeOnMinorFactionTeam="true"
           icon_name_for_lobby="Ships1/MarauderOutpost"
		   defeat_condition="HasNoStrength"
           >
      <custom_field name="Intensity" display_name="强度" description="它们可能对游戏进程产生多大影响？
	  将此值设置为与AI主要难度相等比较合适。"
          sort_group="200" setting_type="IntSlider" default="5" min="1" max="10"/>
      <custom_field name="Allegiance" display_name="派系立场" description="这个派系对AI、人类还是中立？"
                    sort_group="250" setting_type="CustomDropdownArbitraryOptions" arbitrary_options="对所有敌对,对玩家友好,仅对玩家敌对,小派系小队红,小派系小队蓝,小派系小队绿" default_option="对所有敌对" />
      <custom_field name="Intelligence" display_name="智能等级" description="掠夺者扩张时应使用什么策略？战术家(Tactician)更聪明，蛮力(Brute Force)更简单直接"
                    sort_group="250" setting_type="CustomDropdownArbitraryOptions" arbitrary_options="战术家,蛮力" default_option="战术家" />
      <custom_field name="InvasionTime" display_name="入侵时间" description="可以设置掠夺者在游戏中的某个未知时间开始入侵银河系，或者立即开始。"
                    sort_group="300" setting_type="CustomDropdownArbitraryOptions" arbitrary_options="立即,游戏早期,游戏中期,游戏后期" default_option="立即" />
      <vassal_order order_type="MoveToPlanet" sort_group="100"/>
      <vassal_order order_type="AttackPlanet" sort_group="200"/>
      <vassal_order order_type="AttackUnit" sort_group="250"/>
  </faction>
  
    <faction name="AIRiskAnalyzers"
           display_name="AI风险分析器" short_name="AI Risk" processing_group="AIRiskAnalyzers"
           base_info_source="RiskAnalyzerFactionBaseInfo"
           deep_info_source="RiskAnalyzerFactionDeepInfo"
           team_center_color="cE32636" team_border_color="cA52A2A"
           type="SpecialFaction"
           must_be_at_most_one="true"
           description="最多10个风险分析器散布在银河系各处。每小时AI会使用它们分析你的存在，每个分析器会使AIP增加1。如果摧毁一个分析器，会产生10点AIP。如果捕获它们，你可以向AI提供错误数据；每个被捕获的风险分析器每小时会使AIP降低2。你控制的分析器越多，AI发起的系外打击力量就越强大。如果分析器在AI行星上，对打击力量的贡献很小；在中立行星上贡献较大；如果在你拥有的行星上，随时间推移会极大增强打击力量。
		   
&lt;color=#f25e1c&gt;高影响:&lt;/color&gt; 这显著增强了AI，既增加了你的AI进度(AIP)，又创造了更多针对你的攻击，其频率和力量取决于你与它们的互动方式。可以通过AIP降低开启一些有趣的策略。"
           takes_on_highest_current_general_mark_level_of_any_ai_faction="true"
           upgrades_ships_to_general_mark_level_if_they_are_lower="true"
           allied_to_ai_by_default="true"
           impact="Moderate"
           CanBeAlliedToAI="true"
           icon_name_for_lobby="Ships1/RiskAnalyzer"
		   creases_hack_responses_if_all_ais_are_defeated="true"
           >
      <custom_field name="NumberToSeed" display_name="初始分析器数量" description="初始生成的分析器数量。"
          sort_group="200" setting_type="IntSlider" default="5" min="1" max="10"/>
    <custom_field name="ResponseStrength" display_name="响应强度" description="AI在风险分析器方面的整体强度。增加系外打击力量的力量和间隔。"
          sort_group="250" setting_type="IntSlider" default="5" min="1" max="10"/>
    <custom_field name="timeIntervalForAnalyzer" display_name="分析器效果间隔(分钟)" description="AIP变化之间的分钟数。"
          is_advanced_setting="true" sort_group="300" setting_type="IntSlider" default="60" min="15" max="120"/>
    <custom_field name="AIPIncrease" display_name="AI的AIP增加量" description="当分析器被AI控制时，AIP的增加量。"
          is_advanced_setting="true" sort_group="350" setting_type="IntSlider" default="1" min="1" max="10"/>
	  <custom_field name="AIPDecrease" display_name="人类的AIP减少量" description="当分析器被人类控制时，AIP的减少量。"
          is_advanced_setting="true" sort_group="400" setting_type="IntSlider" default="2" min="0" max="10"/>
	  <custom_field name="AIPIncreaseOnDeath" display_name="死亡时的AIP增加量" description="分析器死亡时AIP的增加量。"
          is_advanced_setting="true" sort_group="500" setting_type="IntSlider" default="10" min="1" max="20"/>
  </faction>
  
    <faction name="DarkSpire"
           display_name="黑暗尖塔" short_name="Dark Spire" processing_group="DarkSpire"
           base_info_source="DarkSpireFactionBaseInfo"
           deep_info_source="DarkSpireFactionDeepInfo"
           team_center_color="cFFF8DC" team_border_color="cC41E3A"
           type="SpecialFaction"
           must_be_at_most_one="true"
           templar_avoids_me="true"
           description="银河系中AI行星上存在几个神秘古老的结构。它们无法被伤害也没有任何武器，但当同行星上有飞船死亡时会吸收能量。当它们吸收过多能量时会发生什么？
		   
&lt;color=#f25e1c&gt;高影响:&lt;/color&gt; 这个派系玩法非常不同，通常是反应性的。根据事件不同，它们可能几乎什么都不做，也可能主宰整个银河系。"
           ai_can_send_waves_against_this="false"
           impact="Brutal"
           CanBeHostileToAll="true"
           CanBeDarkAlliance="true"
           icon_name_for_lobby="Ships1/VengeanceGenerator"
		   defeat_condition="HasNoStrength"
           >
      <npc_ship_cap name="Strikecraft" overriding_per_faction_cap_of_stacks="2000" />
      <custom_field name="Intensity" display_name="强度" description="这个派系有多可怕？更高的强度会使它们致命得多。
	  将此值设置为AI主要难度减2比较合适。"
                    sort_group="200" setting_type="IntSlider" default="5" min="1" max="10"/>
      <custom_field name="EnableExpansion" is_advanced_setting="true" display_name="启用扩张" description="启用后，如果黑暗尖塔现有的复仇生成器附近有未防御的行星，它们可以生成新的复仇生成器。"
                  sort_group="300" setting_type="BoolToggle" default="true"  />
	  <custom_field name="AlternateSpawningStyle" is_advanced_setting="true" display_name="替代生成逻辑" description="启用后，使用不同的单位生成逻辑。单位组成将更加多样化，而不是通常的最终全是Eidolons。"
					sort_group="350" setting_type="BoolToggle" default="false"  />

  </faction>
  
    <faction name="AstroTrains"
           display_name="星际列车" short_name="Astro Trains" processing_group="AstroTrains"
           base_info_source="AstroTrainsFactionBaseInfo"
           deep_info_source="AstroTrainsFactionDeepInfo"
           team_center_color="cA81C07" team_border_color="cFF7F50"
           icon_name_for_lobby="Ships1/AstroTrain" 
